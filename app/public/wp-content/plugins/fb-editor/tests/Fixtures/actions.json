    "cases": [
        {
            "name": "every type, with its parameters",
            "attribute": {
                "anchor": "card01",
                "actions": [
                    {
                        "on": [
                            {
                                "type": "click"
                            },
                            {
                                "type": "hover"
                            },
                            {
                                "type": "enters-view",
                                "params": {
                                    "everyTime": true
                                }
                            },
                            {
                                "type": "page-load"
                            }
                        ],
                        "if": [
                            {
                                "type": "is-open",
                                "params": {
                                    "target": "self",
                                    "open": false
                                }
                            },
                            {
                                "type": "has-class",
                                "params": {
                                    "target": {
                                        "block": "pnl001"
                                    },
                                    "className": "is-active",
                                    "has": true
                                }
                            }
                        ],
                        "do": [
                            {
                                "type": "link",
                                "params": {
                                    "link": {
                                        "url": "/about#team",
                                        "newTab": true
                                    },
                                    "label": "About us"
                                }
                            },
                            {
                                "type": "open-close",
                                "params": {
                                    "mode": "close",
                                    "target": {
                                        "block": "pnl001"
                                    },
                                    "startOpen": true,
                                    "keepLayout": false
                                }
                            },
                            {
                                "type": "class",
                                "params": {
                                    "mode": "remove",
                                    "className": "is-active",
                                    "target": "self"
                                }
                            },
                            {
                                "type": "scroll-to",
                                "params": {
                                    "target": {
                                        "block": "pnl001"
                                    },
                                    "offset": {
                                        "kind": "custom",
                                        "value": -4.5,
                                        "unit": "rem"
                                    }
                                }
                            }
                        ],
                        "off": [
                            "mobile",
                            "mobile",
                            "tablet"
                        ],
                        "undo": "leave"
                    }
                ]
            },
            "anchor": "card01",
            "rules": [
                {
                    "on": [
                        {
                            "type": "click",
                            "params": {}
                        },
                        {
                            "type": "hover",
                            "params": {}
                        },
                        {
