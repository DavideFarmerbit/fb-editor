                    "do": [
                        {
                            "type": "link",
                            "params": {
                                "link": {
                                    "url": "/about#team",
                                    "newTab": true,
                                    "nofollow": false
                                },
                                "label": "About us"
                            }
                        },
                        {
                            "type": "open-close",
                            "params": {
                                "mode": "close",
                                "target": {
                                    "block": "pnl001"
                                },
                                "startOpen": true,
                                "keepLayout": false
