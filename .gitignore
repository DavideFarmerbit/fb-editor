# Ignore everything by default; selectively un-ignore the paths we track.
/*
!/.gitignore

# Walk down into the directories that contain tracked items.
!/app/
/app/*
!/app/public/
/app/public/*
!/app/public/wp-content/
/app/public/wp-content/*
!/app/public/wp-content/themes/
!/app/public/wp-content/plugins/

# Themes: only fb-theme for now.
# To track another theme later, add: !/app/public/wp-content/themes/<name>/
/app/public/wp-content/themes/*
!/app/public/wp-content/themes/fb-theme/

# Plugins: farmerbit-forms is tracked directly, fb is a git submodule.
# To track another plugin later, add: !/app/public/wp-content/plugins/<name>/
/app/public/wp-content/plugins/*
!/app/public/wp-content/plugins/fb-editor/

# Local test-run artifacts, not source.



# Scripts
!/ScriptsAndUtils/
!/ScriptsAndUtils/*

# macOS
.DS_Store
